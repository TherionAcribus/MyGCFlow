# Données de l'utilisateur en développement : audio/ est le dossier des pistes
# sonores (paths.audio_dir()), pas une ressource de l'application. Les musiques
# qu'on y dépose ne doivent pas partir dans le dépôt public.
audio/
# Même chose pour images/ (paths.images_dir()) : avatars, logos et captures
# envoyés depuis l'onglet Images en développement.
images/

# Runtimes de test laissés par un lancement manuel du harnais Playwright.
.e2e_runtime*/

# Journal laissé par Chromium/Playwright lors des tests navigateur.
debug.log

# Fichier vide laissé par la chaîne de compilation Windows (nom de périphérique
# réservé). Git refuse de l'indexer et faisait échouer « git add -A ».
nul

# Exports réels Adventure Lab déposés pour analyse (données personnelles) :
# seules les fixtures anonymisées dérivées dans tests/fixtures/labs/ sont
# versionnées.
labs_sources/
