#: templates/menu_animation.html:253
msgid ""
"Régulier : chaque étape a la même durée à l'écran. Proportionnel : les "
"longues visites et les longs trajets se voient."
msgstr ""
"Gleichmäßig: Jede Station bleibt gleich lang im Bild. Proportional: Lange"
" Besuche und lange Wege werden sichtbar."

#: templates/menu_animation.html:258
msgid "Heures affichées"
msgstr "Angezeigte Uhrzeiten"

#: templates/menu_animation.html:260
msgid "Approximatives (« ≈ 10:40 » quand elles sont estimées)"
msgstr "Ungefähr („≈ 10:40“, wenn geschätzt)"

#: templates/menu_animation.html:261
msgid "Exactes, sans « ≈ »"
msgstr "Genau, ohne „≈“"

#: templates/menu_animation.html:262
msgid "Moments de la journée (matin, midi…)"
msgstr "Tageszeiten (Vormittag, Mittag…)"

#: templates/menu_animation.html:263 templates/menu_informations.html:235
