#: templates/menu_style.html:135
msgid ""
"Les réglages marqués « Profil » ne sont conservés qu'après un clic sur « "
"Sauvegarder ». Un « • » à côté du nom du profil signale des modifications"
" en attente."
msgstr ""
"Settings marked \"Profile\" are kept only after clicking \"Save\". A "
"\"•\" next to the profile name means changes are pending."

#: templates/menu_style.html:142
msgid "Créer un profil avec les réglages actuels"
msgstr "Create a profile with the current settings"

#: templates/menu_style.html:145
msgid "Sauvegarder le profil actif"
msgstr "Save the active profile"

#: templates/menu_style.html:148
msgid "Importer un profil JSON"
msgstr "Import a JSON profile"

