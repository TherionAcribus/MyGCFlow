{
    "options": {
        "engine": "webgl",
        "language": "fr",
        "checkVersion": true
    },
    "map": {
        "default": "stamenToner",
        "vectorMap": {"strokeWidth": 0.6,
                    "strokeColor": "#ffffff",
                    "fillColor": "#000000",
                    "background": "#8c8b8b"
        },
        "stamenToner": {"type": "light"}
    },
    "point": {
        "mode": "vectoriel",
        "shape": "circle",
        "center" : {
            "color": "#ff00ff",
            "size": 3,
            "mode": "gc"
        },
        "border": {
            "color": "#000000",
            "size": 10,
            "mode": "fix"
        }
    },
    "animation":{
        "timePerDay":50,
        "displayDaysWithoutCache": true
    },
    "record": {
        "fps": 24,
        "mode": "images", 
        "mediaRecorder": {
            "enabled": true,
            "mimeType": "video/webm;codecs=vp9",
            "videoBitsPerSecond": 6000000,
            "slowdownFactor": 1,
            "offlineNormalization": true,
            "uploadToServer": true,
            "downloadLocal": true,
            "fileName": "output.webm"
        }
    },
    "infos":{
        "title": {
            "display": true,
            "text": "My Geocaching Map"
        },
        "numberOfCaches": {
            "display": true  
        },
        "currentDate": {
            "display": true
        }
    },
    "flash":{
        "mode": "circle",
        "color": "#FF00FF",
        "duration": 2000,
        "size": 10
    }
}