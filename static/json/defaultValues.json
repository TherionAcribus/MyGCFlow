{
    "options": {
        "language": "fr",
        "checkVersion": true
    },
    "map": {
        "default": "stamenToner",
        "default_center": [2.2137, 46.2276],
        "default_zoom": 6,
        "vectorMap": {"strokeWidth": 0.6,
                    "strokeColor": "#ffffff",
                    "fillColor": "#000000",
                    "background": "#8c8b8b"
        },
        "stamenToner": {"type": "light"}
    },
    "point": {
        "mode": "vectoriel",
        "appearAnimation": false,
        "recentGlowDays": 0,
        "shape": "circle",
        "center" : {
            "color": "#ff00ff",
            "size": 3,
            "mode": "gc"
        },
        "border": {
            "color": "#000000",
            "size": 10,
            "mode": "fix"
        }
    },
    "animation":{
        "timePerDay":50,
        "extraEndSeconds": 0
    },
    "record": {
        "fps": 30,
        "mode": "mediarecorder",
        "captureResolution": "window",
        "uploadRetries": 3,
        "uploadBatchSize": 12,
        "uploadBatchMaxWaitMs": 500,
        "frameRetries": 2,
        "mediaRecorder": {
            "enabled": true,
            "mimeType": "video/webm;codecs=vp9",
            "videoBitsPerSecond": 6000000,
            "slowdownFactor": 1,
            "tailFreezeMs": 3000,
            "offlineNormalization": true,
            "uploadToServer": true,
            "downloadLocal": true,
            "fileName": "gcmap.webm"
        }
    },
    "infos":{
        "title": {
            "display": true,
            "text": "My Geocaching Map"
        },
        "numberOfCaches": {
            "display": true  
        },
        "currentDate": {
            "display": true
        }
    },
    "flash":{
        "mode": "circle",
        "color": "#FF00FF",
        "color_type": "fix",
        "duration": 2000,
        "size": 10
    }
}
