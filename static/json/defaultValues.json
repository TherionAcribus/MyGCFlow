{
    "options": {
        "language": "fr",
        "checkVersion": true,
        "dateFormat": "auto"
    },
    "map": {
        "default": "stamenToner",
        "default_center": [2.2137, 46.2276],
        "default_zoom": 6,
        "vectorMap": {"strokeWidth": 0.6,
                    "strokeColor": "#ffffff",
                    "fillColor": "#000000",
                    "background": "#8c8b8b"
        },
        "stamenToner": {"type": "light"}
    },
    "point": {
        "mode": "vectoriel",
        "appearAnimation": false,
        "recentGlowDays": 0,
        "shape": "circle",
        "center" : {
            "color": "#ff00ff",
            "size": 3,
            "mode": "gc"
        },
        "border": {
            "color": "#000000",
            "size": 10,
            "mode": "fix"
        }
    },
    "animation":{
        "rhythmMode": "rate",
        "daysPerSecond": 20,
        "totalDurationSeconds": 60,
        "timePerDay":50,
        "cameraFollow": false,
        "cameraDynamism": 2,
        "extraEndSeconds": 0
    },
    "record": {
        "fps": 30,
        "mode": "mediarecorder",
        "captureResolution": "window",
        "colorFidelity": "compatible",
        "uploadRetries": 3,
        "uploadBatchSize": 12,
        "uploadBatchMaxWaitMs": 500,
        "frameRetries": 2,
        "mediaRecorder": {
            "enabled": true,
            "mimeType": "video/webm;codecs=vp9",
            "videoBitsPerSecond": 6000000,
            "slowdownFactor": 1,
            "tailFreezeMs": 3000,
            "offlineNormalization": true,
            "uploadToServer": true,
            "downloadLocal": true,
            "fileName": "mygcflow.webm"
        }
    },
    "infos":{
        "title": {
            "display": true,
            "text": "My Geocaching Map"
        },
        "numberOfCaches": {
            "display": true  
        },
        "currentDate": {
            "display": true
        }
    },
    "flash":{
        "mode": "circle",
        "color": "#FF00FF",
        "color_type": "fix",
        "border_color": "#000000",
        "border_color_type": "auto",
        "duration": 2000,
        "size": 10,
        "disappear": {
            "mode": "implode",
            "color": "#9E9E9E",
            "color_type": "fix",
            "border_color": "#000000",
            "border_color_type": "auto",
            "size": 30
        }
    },
    "trail": {
        "enabled": false,
        "routing": "clusters",
        "clusterKm": 2,
        "jumpKm": 150,
        "jumpStyle": "arc",
        "curve": "straight",
        "color": "#00B8D4",
        "width": 3,
        "opacity": 85,
        "lineStyle": "solid",
        "effect": "none",
        "head": "dot",
        "persistDays": 30,
        "duration": 800
    }
}
