        <sym>Geocache Found</sym>
        <type>Geocache|Lab Cache</type>
        <gsak:wptExtension xmlns:gsak="http://www.gsak.net/xmlv1/6">
            <gsak:Code>LCZZZ4-1</gsak:Code>
